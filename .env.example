# --- TypeSafe Jev (decision layer) ---
TYPESAFE_API_KEY=
# Pin a model version for reproducible thresholds (e.g. jev-1.13.0). Default: jev-latest.
TYPESAFE_MODEL=jev-latest

# --- General LLM (provider-agnostic via langchain init_chat_model) ---
# Supported LLM_PROVIDER values depend on installed langchain packages:
#   openai, anthropic, google_genai, nim (NVIDIA NIM), openai_compatible, ...
# For NVIDIA NIM / any OpenAI-compatible endpoint use provider "nim":
#   LLM_PROVIDER=nim
#   LLM_MODEL=meta/llama-3.3-70b-instruct
#   NVIDIA_API_KEY=nvapi-...
# For a self-hosted NIM container / local vLLM / proxy, set LLM_BASE_URL:
#   LLM_BASE_URL=http://localhost:8000/v1
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# Optional: OpenAI-compatible base URL override (used by nim / openai_compatible).
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# --- Search tools ---
# Provider: duckduckgo (no key required) or tavily (requires TAVILY_API_KEY)
SEARCH_PROVIDER=duckduckgo
SEARCH_RESULTS=5
TAVILY_API_KEY=

# --- Agent policy ---
# Max research loops before the agent is forced to finish.
MAX_RESEARCH_STEPS=4
# Jev action Choice must be at least this confident, otherwise policy fallback kicks in.
ACTION_CONFIDENCE_THRESHOLD=0.6
# Jev "enough information" Noul must reach this to stop researching.
STOP_CONFIDENCE_THRESHOLD=0.7
# Minimum searches performed before the agent is allowed to stop.
MIN_SEARCHES_BEFORE_STOP=1
# How many most-recent observations are fed back into Jev state.
RECENT_OBSERVATIONS=4

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=jev-research-agent
LANGCHAIN_API_KEY=